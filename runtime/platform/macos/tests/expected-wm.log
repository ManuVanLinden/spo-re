# Expected WM_* log for tests/input-script.txt, written by hand BEFORE the implementation.
# Format: D = returned by PeekMessageW and dispatched; S = sent synchronously (inside PeekMessageW,
# DefWindowProcW, UpdateWindow or a window-state change); Q = WM_QUIT returned by PeekMessageW.
# Two spaces of indent per nesting level. scr(x,y) = a screen-coordinate lParam shown after ScreenToClient.
# "= ks(vk)" lines follow every keyboard message: GetKeyState(vk) and GetAsyncKeyState(vk)&0x8000 read
# inside the window procedure. The test window procedure handles WM_PAINT (BeginPaint/EndPaint and a
# Metal frame), WM_ERASEBKGND (returns 1), WM_SETCURSOR (returns TRUE) and WM_CLOSE (PostQuitMessage(0)),
# and passes everything else to DefWindowProcW.
# step show
S WM_SHOWWINDOW w=0x00000001 l=0x00000000
S WM_ACTIVATEAPP w=0x00000001 l=0x00000000
S WM_NCACTIVATE w=0x00000001 l=0x00000000
S WM_ACTIVATE w=0x00000001 l=0x00000000
  S WM_SETFOCUS w=0x00000000 l=0x00000000
S WM_PAINT w=0x00000000 l=0x00000000
  S WM_ERASEBKGND w=0x00DC0001 l=0x00000000
-- pump
D WM_PAINT w=0x00000000 l=0x00000000
# step key_a
-- pump
D WM_KEYDOWN w=0x00000041 l=0x001E0001
  = ks(0x41)=0xFF81 async=0
D WM_CHAR w=0x00000061 l=0x001E0001
D WM_KEYUP w=0x00000041 l=0xC01E0001
  = ks(0x41)=0x0001 async=0
D WM_PAINT w=0x00000000 l=0x00000000
# step shift_b
-- pump
D WM_KEYDOWN w=0x00000010 l=0x002A0001
  = ks(0x10)=0xFF81 async=0
D WM_KEYDOWN w=0x00000042 l=0x00300001
  = ks(0x42)=0xFF81 async=0
D WM_CHAR w=0x00000042 l=0x00300001
D WM_KEYUP w=0x00000042 l=0xC0300001
  = ks(0x42)=0x0001 async=0
D WM_KEYUP w=0x00000010 l=0xC02A0001
  = ks(0x10)=0x0001 async=0
D WM_PAINT w=0x00000000 l=0x00000000
# step repeat_j
-- pump
D WM_KEYDOWN w=0x0000004A l=0x00240001
  = ks(0x4A)=0xFF81 async=0
D WM_CHAR w=0x0000006A l=0x00240001
D WM_KEYDOWN w=0x0000004A l=0x40240001
  = ks(0x4A)=0xFF81 async=0
D WM_CHAR w=0x0000006A l=0x40240001
D WM_KEYDOWN w=0x0000004A l=0x40240001
  = ks(0x4A)=0xFF81 async=0
D WM_CHAR w=0x0000006A l=0x40240001
D WM_KEYUP w=0x0000004A l=0xC0240001
  = ks(0x4A)=0x0001 async=0
D WM_PAINT w=0x00000000 l=0x00000000
# step cmd_c_as_ctrl
-- pump
D WM_KEYDOWN w=0x00000011 l=0x001D0001
  = ks(0x11)=0xFF81 async=0
D WM_KEYDOWN w=0x00000043 l=0x002E0001
  = ks(0x43)=0xFF81 async=0
D WM_CHAR w=0x00000003 l=0x002E0001
D WM_KEYUP w=0x00000043 l=0xC02E0001
  = ks(0x43)=0x0001 async=0
D WM_KEYUP w=0x00000011 l=0xC01D0001
  = ks(0x11)=0x0001 async=0
D WM_PAINT w=0x00000000 l=0x00000000
# step alt_x
-- pump
D WM_SYSKEYDOWN w=0x00000012 l=0x20380001
  = ks(0x12)=0xFF81 async=0
D WM_SYSKEYDOWN w=0x00000058 l=0x202D0001
  = ks(0x58)=0xFF81 async=0
D WM_SYSCHAR w=0x00000078 l=0x202D0001
D WM_SYSKEYUP w=0x00000058 l=0xE02D0001
  = ks(0x58)=0x0001 async=0
D WM_KEYUP w=0x00000012 l=0xC0380001
  = ks(0x12)=0x0001 async=0
D WM_PAINT w=0x00000000 l=0x00000000
# step alt_alone
-- pump
D WM_SYSKEYDOWN w=0x00000012 l=0x20380001
  = ks(0x12)=0xFF80 async=0
D WM_SYSKEYUP w=0x00000012 l=0xC0380001
  = ks(0x12)=0x0000 async=0
D WM_PAINT w=0x00000000 l=0x00000000
# step caps
-- pump
D WM_KEYDOWN w=0x00000014 l=0x003A0001
  = ks(0x14)=0xFF81 async=0
D WM_KEYUP w=0x00000014 l=0xC03A0001
  = ks(0x14)=0x0001 async=0
D WM_KEYDOWN w=0x00000014 l=0x003A0001
  = ks(0x14)=0xFF80 async=0
D WM_KEYUP w=0x00000014 l=0xC03A0001
  = ks(0x14)=0x0000 async=0
D WM_PAINT w=0x00000000 l=0x00000000
# step specials
-- pump
D WM_KEYDOWN w=0x0000001B l=0x00010001
  = ks(0x1B)=0xFF81 async=0
D WM_CHAR w=0x0000001B l=0x00010001
D WM_KEYUP w=0x0000001B l=0xC0010001
  = ks(0x1B)=0x0001 async=0
D WM_KEYDOWN w=0x00000008 l=0x000E0001
  = ks(0x08)=0xFF81 async=0
D WM_CHAR w=0x00000008 l=0x000E0001
D WM_KEYUP w=0x00000008 l=0xC00E0001
  = ks(0x08)=0x0001 async=0
D WM_KEYDOWN w=0x0000000D l=0x011C0001
  = ks(0x0D)=0xFF81 async=0
D WM_CHAR w=0x0000000D l=0x011C0001
D WM_KEYUP w=0x0000000D l=0xC11C0001
  = ks(0x0D)=0x0001 async=0
D WM_KEYDOWN w=0x00000065 l=0x004C0001
  = ks(0x65)=0xFF81 async=0
D WM_CHAR w=0x00000035 l=0x004C0001
D WM_KEYUP w=0x00000065 l=0xC04C0001
  = ks(0x65)=0x0001 async=0
D WM_KEYDOWN w=0x00000074 l=0x003F0001
  = ks(0x74)=0xFF81 async=0
D WM_KEYUP w=0x00000074 l=0xC03F0001
  = ks(0x74)=0x0001 async=0
D WM_KEYDOWN w=0x00000025 l=0x014B0001
  = ks(0x25)=0xFF81 async=0
D WM_KEYUP w=0x00000025 l=0xC14B0001
  = ks(0x25)=0x0001 async=0
D WM_PAINT w=0x00000000 l=0x00000000
# step mouse_move
-- pump
S WM_NCHITTEST w=0x00000000 l=scr(120,60)
S WM_SETCURSOR w=0x00010001 l=0x02000001
D WM_MOUSEMOVE w=0x00000000 l=0x003C0078
D WM_PAINT w=0x00000000 l=0x00000000
# step click
-- pump
S WM_NCHITTEST w=0x00000000 l=scr(200,100)
S WM_SETCURSOR w=0x00010001 l=0x02000001
D WM_MOUSEMOVE w=0x00000000 l=0x006400C8
S WM_NCHITTEST w=0x00000000 l=scr(200,100)
S WM_SETCURSOR w=0x00010001 l=0x02010001
D WM_LBUTTONDOWN w=0x00000001 l=0x006400C8
S WM_NCHITTEST w=0x00000000 l=scr(200,100)
S WM_SETCURSOR w=0x00010001 l=0x02020001
D WM_LBUTTONUP w=0x00000000 l=0x006400C8
D WM_PAINT w=0x00000000 l=0x00000000
# step dblclick
-- pump
S WM_NCHITTEST w=0x00000000 l=scr(200,100)
S WM_SETCURSOR w=0x00010001 l=0x02010001
D WM_LBUTTONDOWN w=0x00000001 l=0x006400C8
S WM_NCHITTEST w=0x00000000 l=scr(200,100)
S WM_SETCURSOR w=0x00010001 l=0x02020001
D WM_LBUTTONUP w=0x00000000 l=0x006400C8
S WM_NCHITTEST w=0x00000000 l=scr(200,100)
S WM_SETCURSOR w=0x00010001 l=0x02030001
D WM_LBUTTONDBLCLK w=0x00000001 l=0x006400C8
S WM_NCHITTEST w=0x00000000 l=scr(200,100)
S WM_SETCURSOR w=0x00010001 l=0x02020001
D WM_LBUTTONUP w=0x00000000 l=0x006400C8
D WM_PAINT w=0x00000000 l=0x00000000
# step right_drag
-- pump
S WM_NCHITTEST w=0x00000000 l=scr(300,200)
S WM_SETCURSOR w=0x00010001 l=0x02000001
D WM_MOUSEMOVE w=0x00000000 l=0x00C8012C
S WM_NCHITTEST w=0x00000000 l=scr(300,200)
S WM_SETCURSOR w=0x00010001 l=0x02040001
D WM_RBUTTONDOWN w=0x00000002 l=0x00C8012C
S WM_NCHITTEST w=0x00000000 l=scr(320,220)
S WM_SETCURSOR w=0x00010001 l=0x02000001
D WM_MOUSEMOVE w=0x00000002 l=0x00DC0140
S WM_NCHITTEST w=0x00000000 l=scr(320,220)
S WM_SETCURSOR w=0x00010001 l=0x02050001
D WM_RBUTTONUP w=0x00000000 l=0x00DC0140
  S WM_CONTEXTMENU w=0x00010001 l=scr(320,220)
D WM_PAINT w=0x00000000 l=0x00000000
# step wheel
-- pump
D WM_MOUSEWHEEL w=0x00780000 l=scr(320,220)
D WM_MOUSEWHEEL w=0xFF100000 l=scr(320,220)
D WM_PAINT w=0x00000000 l=0x00000000
# step resize
S WM_SIZE w=0x00000000 l=0x02580320
-- pump
D WM_PAINT w=0x00000000 l=0x00000000
  S WM_ERASEBKGND w=0x00DC0001 l=0x00000000
# step order
-- pump
D WM_USER+0x100 w=0x00000001 l=0x00000002
D WM_USER+0x101 w=0x00000003 l=0x00000004
D WM_KEYDOWN w=0x00000041 l=0x001E0001
  = ks(0x41)=0xFF80 async=0
D WM_CHAR w=0x00000061 l=0x001E0001
D WM_KEYUP w=0x00000041 l=0xC01E0001
  = ks(0x41)=0x0000 async=0
D WM_PAINT w=0x00000000 l=0x00000000
# step deactivate
S WM_NCACTIVATE w=0x00000000 l=0x00000000
S WM_ACTIVATE w=0x00000000 l=0x00000000
S WM_ACTIVATEAPP w=0x00000000 l=0x00000000
S WM_KILLFOCUS w=0x00000000 l=0x00000000
-- pump
D WM_PAINT w=0x00000000 l=0x00000000
# step activate
S WM_ACTIVATEAPP w=0x00000001 l=0x00000000
S WM_NCACTIVATE w=0x00000001 l=0x00000000
S WM_ACTIVATE w=0x00000001 l=0x00000000
  S WM_SETFOCUS w=0x00000000 l=0x00000000
-- pump
D WM_PAINT w=0x00000000 l=0x00000000
# step close
S WM_CLOSE w=0x00000000 l=0x00000000
-- pump
Q WM_QUIT w=0x00000000 l=0x00000000
